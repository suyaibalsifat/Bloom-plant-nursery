<%- include('partials/header') %>

  <section class="page-header">
    <h1>About Bloom</h1>
    <p>Growing happiness, one plant at a time.</p>
  </section>

  <section class="section">
    <div class="about-story">
      <h2>Our Story</h2>
      <p>Bloom was founded in 2020 with a simple mission: to make sustainable, beautiful plants accessible to everyone.
        What started as a small backyard operation has grown into a thriving nursery dedicated to eco-friendly practices
        and healthy plants.</p>
      <p>We believe that bringing nature into your home shouldn't come at the cost of the environment. That's why we use
        plastic-free packaging, organic soil, and sustainable growing methods.</p>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Meet the Team</h2>
    <div class="team-grid">
      <div class="team-card">
        <div class="team-avatar">👩‍🌾</div>
        <h3>Sarah Green</h3>
        <p>Founder & Head Grower</p>
        <p class="team-bio">With 15 years of horticulture experience, Sarah leads our growing operations.</p>
      </div>
      <div class="team-card">
        <div class="team-avatar">👨‍🌾</div>
        <h3>Marcus Leaf</h3>
        <p>Plant Specialist</p>
        <p class="team-bio">Marcus curates our collection and ensures every plant is healthy before shipping.</p>
      </div>
      <div class="team-card">
        <div class="team-avatar">👩‍💼</div>
        <h3>Emma Bloom</h3>
        <p>Customer Care</p>
        <p class="team-bio">Emma helps customers find the perfect plant for their space and lifestyle.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Our Sustainability Practices</h2>
    <div class="practices-grid">
      <div class="practice">
        <span class="practice-icon">♻️</span>
        <h3>Plastic-Free Packaging</h3>
        <p>All orders ship in biodegradable and recyclable materials.</p>
      </div>
      <div class="practice">
        <span class="practice-icon">🌱</span>
        <h3>Organic Soil</h3>
        <p>We use only organic, peat-free soil mixes for all our plants.</p>
      </div>
      <div class="practice">
        <span class="practice-icon">💧</span>
        <h3>Water Conservation</h3>
        <p>Drip irrigation and rainwater harvesting reduce our water usage.</p>
      </div>
      <div class="practice">
        <span class="practice-icon">🌍</span>
        <h3>Carbon Neutral Shipping</h3>
        <p>We offset 100% of shipping emissions through verified programs.</p>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>